# Claude (Anthropic) API — get this from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# WhatsApp Business Cloud API (Meta) — from developers.facebook.com
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string you choose yourself, used to verify the webhook with Meta
WHATSAPP_VERIFY_TOKEN=choose-your-own-secret-string

# Which file in backend/knowledge/ to use as the bot's business profile
ACTIVE_BUSINESS=restaurant

PORT=3000
