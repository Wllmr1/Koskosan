# ─── app ───────────────────────────────────────────────────────────────
APP_URL="https://kos.example.com"          # public base URL, no trailing slash
NODE_ENV="production"

# ─── database ──────────────────────────────────────────────────────────
DATABASE_URL="postgresql://kos:password@localhost:5432/kos?schema=public"

# ─── secrets (generate with: openssl rand -hex 32) ─────────────────────
ENCRYPTION_KEY=""        # 64 hex chars. Encrypts KTP numbers at rest. NEVER rotate without re-encrypting.
SESSION_SECRET=""        # 64 hex chars. Signs the owner dashboard cookie.
CRON_SECRET=""           # 64 hex chars. Bearer token for /api/cron/* endpoints.
ADMIN_PASSWORD=""        # owner dashboard password

# ─── Claude ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-haiku-4-5-20251001"

# ─── WhatsApp Cloud API ────────────────────────────────────────────────
WA_GRAPH_VERSION="v21.0"
WA_PHONE_NUMBER_ID=""
WA_BOT_PHONE_E164=""     # the assistant's WhatsApp number, e.g. +628111222333 — the site's chat buttons open this
WA_BUSINESS_ACCOUNT_ID=""
WA_ACCESS_TOKEN=""       # permanent system-user token
WA_APP_SECRET=""         # Meta app secret, verifies webhook signatures
WA_VERIFY_TOKEN=""       # any random string, also pasted into Meta's webhook setup

# ─── Xendit ────────────────────────────────────────────────────────────
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""  # "Verification token" from the Xendit dashboard

# ─── owner notifications ───────────────────────────────────────────────
OWNER_NAME="Bu Sari"
OWNER_EMAIL="owner@example.com"
OWNER_PHONE_E164="+628123456789"   # also used for the owner WhatsApp alert
RESEND_API_KEY=""                   # leave blank to skip email
EMAIL_FROM="Kos Wisma Anggrek <noreply@example.com>"

# ─── KTP / signature storage ───────────────────────────────────────────
# driver "local" writes to ./storage (fine for a single VPS with a backed-up volume)
# driver "s3" works with Cloudflare R2, idCloudHost, AWS, Wasabi…
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
