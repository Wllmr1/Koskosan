// Kos chatbot — PostgreSQL + Prisma
// Money is stored as integer Rupiah. Never use Float for money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── enums ───────────────────────────────

enum ContactType {
  PROSPECT // not a renter: Contact + chat deleted 24h after last message
  MEMBER // renter: kept, linked to a Tenant
}

enum RoomStatus {
  AVAILABLE
  BOOKED
  OCCUPIED
  MAINTENANCE
}

enum LeasePlan {
  MONTHLY
  YEARLY
}

enum LeaseStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
}

enum InvoiceKind {
  RENT
  DEPOSIT
  ONBOARDING // first payment + deposit in one invoice
  GUEST
  UTILITY_OVERAGE
  LATE_FEE
  SERVICE
}

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
  EXPIRED
}

enum ApplicationStatus {
  DRAFT
  DETAILS_SUBMITTED
  SIGNED
  AWAITING_PAYMENT
  COMPLETED
  NEEDS_REVIEW // paid, but the phone belongs to a different existing renter — owner decides
  EXPIRED
  CANCELLED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Channel {
  WEB
  WHATSAPP
}

// ─────────────────────────── who is texting ───────────────────────────

/// One row per conversation partner: a WhatsApp number, an anonymous website
/// visitor ("anon:<id>"), or a logged-in renter on the website ("renter:<tenantId>").
model Contact {
  id            String         @id @default(cuid())
  channel       Channel        @default(WHATSAPP)
  waId          String?        @unique // WhatsApp only: digits, 6281234567890
  phoneE164     String?        @unique // WhatsApp only: +6281234567890
  webSessionId  String?        @unique // website only
  displayName   String?
  type          ContactType    @default(PROSPECT)
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  verifiedAt    DateTime? // WhatsApp: set once the one-time link proves ownership
  handoffUntil  DateTime? // WhatsApp: while set, the bot stays silent and a human replies
  blockedUntil  DateTime? // abuse cooldown
  lastMessageAt DateTime       @default(now())
  expiresAt     DateTime? // PROSPECT: lastMessageAt + 24h. MEMBER: null
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  verifyTokens  VerifyToken[]
  applications  Application[]

  @@index([type, expiresAt])
  @@index([lastMessageAt])
  @@index([tenantId])
}

/// One-time link proving a WhatsApp number belongs to a tenant.
model VerifyToken {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the raw token; the raw value is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// ──────────────────────────── renters ────────────────────────────

model Tenant {
  id             String               @id @default(cuid())
  accountCode    String               @unique // "WA-0042"
  fullName       String
  phoneE164      String               @unique
  email          String?
  dateOfBirth    DateTime             @db.Date
  idNumberEnc    String // KTP number, AES-256-GCM, stored as iv:tag:ciphertext hex
  idLast4        String               @db.Char(4)
  ktpObjectKey   String? // private storage key, never a public URL
  createdAt      DateTime             @default(now())
  contacts       Contact[]
  passwordHash   String? // scrypt$<salt>$<hash>; null until set
  sessionVersion Int                  @default(0) // bump to log out every device
  passwordTokens PasswordSetupToken[]
  leases         Lease[]
  guests         GuestStay[]
  tickets        Ticket[]
}

/// What a renter chooses: price, size, bathroom, furnishings and photos live here.
model RoomType {
  id           String   @id @default(cuid())
  slug         String   @unique // "vip-a"
  name         String   @unique // "VIP A"
  description  String   @default("")
  sizeLabel    String
  monthlyPrice Int
  bathroom     String
  extras       String
  isNew        Boolean  @default(false)
  isVip        Boolean  @default(false)
  hasEnsuite   Boolean  @default(false)
  sortOrder    Int      @default(0)
  rooms        Room[]
  photos       Photo[]
  updatedAt    DateTime @updatedAt
}

model Room {
  id           String          @id @default(cuid())
  code         String          @unique // "B-204"
  roomTypeId   String
  roomType     RoomType        @relation(fields: [roomTypeId], references: [id])
  floor        Int
  status       RoomStatus      @default(AVAILABLE)
  availableOn  DateTime?       @db.Date
  sortOrder    Int             @default(0)
  leases       Lease[]
  utility      UtilityPeriod[]
  applications Application[]
  hidden       Boolean         @default(false) // hidden rooms vanish from the site and the assistant
  updatedAt    DateTime        @updatedAt

  @@index([roomTypeId, status])
  @@index([status])
}

model Lease {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  roomId      String
  room        Room        @relation(fields: [roomId], references: [id])
  plan        LeasePlan
  monthlyRent Int // copied at signing, so later price changes never rewrite history
  deposit     Int
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  status      LeaseStatus @default(PENDING)
  signedAt    DateTime?
  contractKey String? // signed PDF in private storage
  invoices    Invoice[]
  createdAt   DateTime    @default(now())

  @@index([tenantId, status])
  @@index([roomId, status])
}

model Invoice {
  id               String        @id @default(cuid())
  code             String        @unique
  leaseId          String?
  lease            Lease?        @relation(fields: [leaseId], references: [id])
  applicationId    String?
  application      Application?  @relation(fields: [applicationId], references: [id])
  guestStayId      String?       @unique
  guestStay        GuestStay?    @relation(fields: [guestStayId], references: [id])
  kind             InvoiceKind
  description      String
  period           DateTime?     @db.Date
  amount           Int
  amountPaid       Int           @default(0)
  dueDate          DateTime      @db.Date
  status           InvoiceStatus @default(UNPAID)
  gatewayInvoiceId String?       @unique
  gatewayUrl       String?
  expiresAt        DateTime?
  payments         Payment[]
  createdAt        DateTime      @default(now())

  @@index([leaseId, status])
  @@index([status, dueDate])
}

/// Written only by the Xendit webhook. The chatbot can never create one.
model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Int
  method     String
  gatewayRef String   @unique // makes the webhook idempotent
  paidAt     DateTime
  raw        Json
}

model UtilityPeriod {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  period     DateTime @db.Date // first day of the month
  quotaKwh   Int      @default(100)
  usedKwh    Decimal  @default(0) @db.Decimal(8, 2)
  ratePerKwh Int      @default(1700)
  source     String   @default("MANUAL")
  updatedAt  DateTime @updatedAt

  @@unique([roomId, period])
}

model GuestStay {
  id          String   @id @default(cuid())
  code        String   @unique
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  guestName   String
  phoneE164   String
  idNumberEnc String
  idLast4     String   @db.Char(4)
  checkIn     DateTime @db.Date
  nights      Int
  fee         Int
  approved    Boolean  @default(false)
  invoice     Invoice?
  createdAt   DateTime @default(now())

  @@index([tenantId, checkIn])
}

model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  category    String
  description String
  urgency     String // biasa | mendesak | darurat
  status      TicketStatus @default(OPEN)
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([status, createdAt])
}

// ───────────────────── secure application flow ─────────────────────

/// One signup attempt. The chat only ever hands out the link; all personal
/// data is collected on the web form, never in WhatsApp.
model Application {
  id                String            @id @default(cuid())
  reference         String            @unique // "APP-1042"
  tokenHash         String            @unique
  contactId         String?
  contact           Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  roomId            String
  room              Room              @relation(fields: [roomId], references: [id])
  plan              LeasePlan
  status            ApplicationStatus @default(DRAFT)
  fullName          String?
  phoneE164         String?
  dateOfBirth       DateTime?         @db.Date
  idNumberEnc       String?
  idLast4           String?           @db.Char(4)
  passwordHash      String? // the renter's chosen password, copied to Tenant on payment
  ktpObjectKey      String?
  signatureKey      String?
  contractKey       String?
  contractHash      String? // SHA-256 of the exact contract text the person signed
  moveInDate        DateTime?         @db.Date
  signedAt          DateTime?
  signedIp          String?
  signedAgent       String?
  amountDue         Int?
  signedMonthlyRent Int? // terms as signed — the lease is built from these, not from today's prices
  signedDeposit     Int?
  termMonths        Int?              // contract length chosen when the application starts (null on older yearly ones)
  signedTermMonths  Int?
  leaseId           String?           @unique
  invoices          Invoice[]
  expiresAt         DateTime
  createdAt         DateTime          @default(now())

  @@index([status, expiresAt])
}

// ─────────────────────────── chat memory ───────────────────────────

model Conversation {
  id        String    @id @default(cuid())
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel   String    @default("whatsapp")
  startedAt DateTime  @default(now())
  messages  Message[]

  @@index([contactId, startedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  toolLog        Json? // tool names + ids only, never personal data
  actions        Json? // link buttons shown with an assistant reply: [{kind,label,path}]
  waMessageId    String?      @unique
  createdAt      DateTime     @default(now())
  expiresAt      DateTime? // PROSPECT: +24h. MEMBER: +90 days

  @@index([conversationId, createdAt])
  @@index([expiresAt])
}

/// Deduplicates Meta's webhook retries so the bot never answers twice.
model ProcessedWebhook {
  key        String   @id // "wa:<message id>" or "xendit:<event id>"
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

/// Simple DB-backed rate limiting. No Redis needed at this scale.
model RateCounter {
  key       String   @id // "wa:6281…:minute:2026-10-09T11:23"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String // bot | owner | webhook:xendit | job:purge
  action    String
  contactId String?
  tenantId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([createdAt])
}

/// Every owner alert that was sent, so nothing is sent twice and you can audit.
model OwnerNotification {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  title     String
  subject   String
  body      String
  sms       String
  channels  String // channels that succeeded: "email,whatsapp"
  template  String   @default("owner_alert")
  sentAt    DateTime @default(now())
  error     String? // set while any channel is still failing; the hourly job retries
  attempts  Int      @default(1)

  @@index([sentAt])
}

// ────────────────── property content (drives the site) ──────────────────

/// Single row (id = "default"). Everything the bot and the site quote.
model PropertySetting {
  id                String   @id @default("default")
  name              String
  tagline           String
  address           String
  mapsUrl           String?
  houseRules        String[] @default([])
  paymentTerms      String[] @default([])
  guestRules        String[] @default([])
  facilities        String[] @default([])
  guestFeePerNight  Int      @default(50000)
  lateFeePerDay     Int      @default(25000)
  lateFeeMax        Int      @default(250000)
  electricQuota     Int      @default(100)
  electricRate      Int      @default(1700)
  dueDayOfMonth     Int      @default(5)
  yearlyMonths      Int      @default(11) // pay 11, get 12
  minMonths         Int      @default(3)
  guestCutoffHour   Int      @default(21)
  depositMonths     Int      @default(1)
  depositReturnDays Int      @default(14)
  utilitiesNote     String   @default("Air dan wifi termasuk, tanpa batas")
  maxGuestNights    Int      @default(3)
  maxGuestsAtOnce   Int      @default(2)
  updatedAt         DateTime @updatedAt
}

model Service {
  id        String @id @default(cuid())
  name      String
  priceNote String
  sortOrder Int    @default(0)
}

model NearbyPlace {
  id        String @id @default(cuid())
  name      String
  distance  String
  sortOrder Int    @default(0)
}

model FaqEntry {
  id        String @id @default(cuid())
  question  String
  answer    String
  sortOrder Int    @default(0)
}

/// Room type photo (roomTypeId set) or property gallery photo (roomTypeId null). Public.
model Photo {
  id         String    @id @default(cuid())
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  caption    String    @default("")
  key        String    @unique // "photos/<random>.webp" in storage
  width      Int
  height     Int
  sortOrder  Int       @default(0)
  isCover    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([roomTypeId, sortOrder])
}

/// Single-use link the owner sends so a renter can set or reset their password.
model PasswordSetupToken {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

/// Someone the owner allowed into the dashboard. The owner themself is not a
/// row: they log in with OWNER_EMAIL + ADMIN_PASSWORD from the environment.
model Admin {
  id           String            @id @default(cuid())
  email        String            @unique // stored lowercase
  name         String
  passwordHash String? // null until they use their setup link
  disabled     Boolean           @default(false)
  createdAt    DateTime          @default(now())
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  setupTokens  AdminSetupToken[]
}

/// One dashboard login. Lives in the database so it can time out after
/// inactivity and be ended instantly (logout, admin disabled).
model AdminSession {
  id         String   @id @default(cuid())
  adminId    String? // null = the owner
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ownerKey   String? // owner only: fingerprint of ADMIN_PASSWORD at login, so changing it ends these sessions
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([adminId])
}

model AdminSetupToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}
