{
  "name": "kos-bot",
  "version": "1.0.0",
  "private": true,
  "description": "WhatsApp rental assistant + property site for a student boarding house (kos) in Indonesia",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:photos": "tsx prisma/import-photos.ts",
    "db:studio": "prisma studio",
    "cron:purge": "tsx src/scripts/run-purge.ts",
    "cron:reminders": "tsx src/scripts/run-reminders.ts",
    "wa:templates": "tsx src/scripts/create-templates.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.1.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.34.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
